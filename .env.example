# Mobile runtime mode
# demo: no backend required, local seeded data
# development: Supabase/Stripe test configuration required
# production: real configuration required, no demo fallback
EXPO_PUBLIC_APP_MODE=demo

# Optional boot guard. Defaults to 5000.
EXPO_PUBLIC_BOOT_TIMEOUT_MS=5000

# Required for EXPO_PUBLIC_APP_MODE=development or production
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLIC_KEY=

# Server-only keys. Keep these out of Expo/mobile env files.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
