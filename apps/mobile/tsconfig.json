{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@meet-champion/shared": ["../../packages/shared/src"],
      "@meet-champion/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["react-native", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/shared/src"
  ]
}
